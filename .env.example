# Copy this to .env and edit it. docker compose reads it by itself.

# Required. The admin page can stop the server and kick players, so it won't
# start without one.
ADMIN_PASSWORD=change-me

# What players see in their Join Game list.
SERVER_NAME=Apogee Server

# 45678 is what every Apogee client tries first. If you change it, players have
# to type "address:port".
GAME_PORT=45678

# How often the world is written to disk. Lower loses less to a crash, and
# higher spends less time serialising a large world.
AUTOSAVE_SECONDS=60

# Announce the server on the LAN so phones find it without typing an address. It
# needs host networking, which docker-compose.yml uses by default.
LAN_DISCOVERY=1

# The admin page.
WEB_PORT=8080
# 127.0.0.1 keeps it to this machine (you reach it over an SSH tunnel).
WEB_BIND=0.0.0.0

# Set this to 1 only if a reverse proxy in front of the admin page terminates
# TLS. It marks the session cookie Secure, which breaks plain HTTP.
HTTPS=0
