# Copy to .env and edit. docker compose reads it automatically.

# Required. The admin page can stop the server and kick players, so it
# refuses to start without one.
ADMIN_PASSWORD=change-me

# What players see in their Join Game list.
SERVER_NAME=Apogee Server

# 45678 is what every Apogee client tries first. Changing it means players
# have to type "address:port".
GAME_PORT=45678

# How often the world is written to disk. Lower loses less to a crash;
# higher spends less time serialising a large world.
AUTOSAVE_SECONDS=60

# Announce the server on the LAN so phones find it without typing an
# address. Needs host networking, which docker-compose.yml uses by default.
LAN_DISCOVERY=1

# The admin page.
WEB_PORT=8080
# 127.0.0.1 to keep it to this machine (reach it over an SSH tunnel).
WEB_BIND=0.0.0.0

# Set to 1 only if a reverse proxy in front of the admin page terminates
# TLS. It marks the session cookie Secure, which breaks plain HTTP.
HTTPS=0
