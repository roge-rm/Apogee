# --- Gradle -----------------------------------------------------------------
.gradle/
# Matches every module's output dir, not just the root one. The Android Studio
# template shipped "/build", which silently stopped covering anything once the
# project grew past a single module.
build/
!gradle/wrapper/gradle-wrapper.jar
!src/**/build/

# --- Local configuration (never committed) ----------------------------------
# Holds this machine's SDK path, and is where release signing credentials go.
local.properties

# The server's compose configuration, which holds ADMIN_PASSWORD.
# .env.example is the template that IS committed.
.env

# --- IDE --------------------------------------------------------------------
# The whole .idea directory stays local. Note git does not descend into an
# excluded directory, so a "!.idea/something" negation below this line would be
# silently inert - if any IDE config is ever meant to be shared, .idea/ has to
# be unexcluded and its contents ignored individually instead.
*.iml
.idea/

# --- Native build artefacts -------------------------------------------------
.externalNativeBuild/
.cxx/

# --- Misc -------------------------------------------------------------------
/captures/
.DS_Store
*.hprof
