<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Multiplayer. INTERNET covers both joining a dedicated server and the
         listening socket when you host a game in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- LAN discovery broadcasts. Android drops multicast and broadcast frames
         to save power unless a MulticastLock is held, and that needs this. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- GLES 3.0 is the floor. 3.1 and 3.2 depend on the driver, not the API
         level, so they're checked at runtime and never required. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apogee">

        <!-- screenOrientation is fullUser: both orientations, respecting the
             user's rotation lock. The activity handles the configuration
             change itself (configChanges below), so rotating mid-flight lays
             out the HUD again without recreating the activity, tearing down
             the GL context or interrupting the simulation.

             windowSoftInputMode is adjustResize so the keyboard's inset
             reaches the view tree and imePadding can keep a form's button
             above it. The game itself never raises a keyboard, so this only
             affects the menus. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
