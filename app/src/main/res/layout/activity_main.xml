<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole app is two views.

  game_surface_host is an empty container that a GLSurfaceView is added to and
  removed from in code, instead of a GLSurfaceView declared here. The surface
  only exists while a screen really needs the 3D world, so the menus don't
  hold a GL context (and its memory) open for no reason.

  hud_compose_view sits above it and carries every pixel of interface in the
  app. Menus, settings and the in-flight overlay are all Compose inside this
  one ComposeView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/game_surface_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hud_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
