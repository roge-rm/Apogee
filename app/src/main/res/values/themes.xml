<?xml version="1.0" encoding="utf-8"?>
<!--
  A shell only. There is no XML-defined look in this app; the theme exists to
  remove the action bar and set the pre-Compose window background.
-->
<resources>
    <style name="Theme.Apogee" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
