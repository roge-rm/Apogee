#!/bin/sh
# Apogee as an AppImage: the app's jars on the Java runtime it carries, with the sound engine
# beside them. The Debian package's launcher (deb/apogee), with everything found inside the image.
here="$(dirname "$(readlink -f "$0")")"
crashes="${XDG_DATA_HOME:-$HOME/.local/share}/apogee/crashes"
mkdir -p "$crashes"
exec "$here/usr/lib/apogee/jre/bin/java" \
    -splash:"$here/usr/lib/apogee/splash.png" \
    -XX:ErrorFile="$crashes/hs_err_%p.log" \
    -Djava.library.path="$here/usr/lib/apogee/native" \
    --enable-native-access=ALL-UNNAMED \
    -cp "$here/usr/lib/apogee/lib/*" \
    com.rm.apogee.desktop.MainKt "$@"
